{
  "id": "iansherr/ikmal_tools_trilium",
  "version": "1.0.35",
  "name": "Ikmal Tools for Trilium",
  "description": "Component-driven, editable, and organizable notes system layer for Trilium Notes with Today Homepage, Template Studio, and If/Then Automation Rules.",
  "author": "Ian Sherr",
  "maintainer": "Ian Sherr",
  "repository": "https://github.com/iansherr/ikmal_tools_trilium",
  "homepage": "https://github.com/iansherr/ikmal_tools_trilium",
  "license": "MIT",
  "maintenance": "active",
  "securityStatus": "reviewed",
  "compatibility": {
    "minTriliumVersion": "0.104.0"
  },
  "permissions": [
    "read-notes",
    "write-notes",
    "delete-notes"
  ],
  "settings": [
    {
      "key": "defaultJournalWidth",
      "type": "number",
      "title": "Journal Split Width (%)",
      "description": "Default width percentage allocated to the Journal side panel on the Today Homepage.",
      "default": 65
    },
    {
      "key": "autoRunIfThenRulesOnCreation",
      "type": "boolean",
      "title": "Execute If/Then Rules on Note Creation",
      "description": "Automatically evaluate if/then automation rules when new notes are created.",
      "default": true
    },
    {
      "key": "enableDerivedTopics",
      "type": "boolean",
      "title": "Enable Derived Topic Propagation",
      "description": "Automatically calculate and assign derived topics from parent project, client, or organization relations.",
      "default": true
    },
    {
      "key": "autoJournalClone",
      "type": "boolean",
      "title": "File New Notes Under Today's Journal Note",
      "description": "Add a reference link for newly created tasks, meetings, and story drafts to the current day note.",
      "default": true
    },
    {
      "key": "defaultQuickCaptureTemplate",
      "type": "string",
      "title": "Default Quick Capture Template",
      "description": "Template ID triggered by default when clicking the global header Quick Capture button.",
      "default": "task"
    },
    {
      "key": "staleThresholdDays",
      "type": "number",
      "title": "Stale Notes Inactivity Threshold (Days)",
      "description": "Number of inactive days before active notes appear in the Stale Notes review list.",
      "default": 14
    },
    {
      "key": "writingGoalWords",
      "type": "number",
      "title": "Daily Writing Goal (Words)",
      "description": "Target daily word count for the Writing Goal progress bar and activity heatmaps.",
      "default": 500
    }
  ],
